# Django
# 必须设置，且不要提交到仓库。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-here
# 生产环境必须为 False（True 会在出错页暴露调试信息）
DEBUG=False
# 逗号分隔，可选；留空则使用 settings.py 中的默认值
# ALLOWED_HOSTS=www.minghaishiyi.cn,minghaishiyi.cn,110.40.159.5,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://www.minghaishiyi.cn,https://minghaishiyi.cn

# 数据库
DB_ENGINE=django.db.backends.mysql
DB_NAME=minghaishiyi
DB_USER=root
DB_PASSWORD=your-password-here
DB_HOST=127.0.0.1
DB_PORT=3306

# CLI：DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com

# CLI：命海拾遗后端
MHSY_URL=http://101.200.89.198:8000/api/destiny-cases/
